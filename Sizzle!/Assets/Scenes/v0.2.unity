  m_Script: {fileID: 11500000, guid: 0f68b34e16916d34f83fbd1e296d604d, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::MejorasUI
  mejoras:
  - nombre: Parrilla
    descripcion: "\u2B50 Nivel 1 \u2013 Control b\xE1sico de temperatura\n\nReduce
      el riesgo de quemar comida.\n\n\u2B50 Nivel 2 \u2013 Cocci\xF3n m\xE1s r\xE1pida\n\n+10%
      velocidad de cocci\xF3n.\n\n\u2B50 Nivel 3 \u2013 Zona de calor optimizada\n\nPermite
      cocinar dos piezas a la vez con penalizaci\xF3n meno"
    nivelActual: 0
    nivelMaximo: 3
    costoPorNivel: 100
    icono: {fileID: 21300000, guid: 2954644a305a4c049ab1100269d65530, type: 3}
    botonUI: {fileID: 640331077}
  - nombre: Cortar
    descripcion: "\u2B50 Nivel 1 \u2013 Cuchillo afilado\n\n+10% velocidad al cortar
      ingredientes.\n\n\u2B50 Nivel 2 \u2013 Cuchillo profesional\n\nVelocidad de
      corte muy aumentada (+25%).\n\n\u2B50 Nivel 3 \u2013 Procesador autom\xE1tico\n\nPermite
      preparar m\xFAltiples ingredientes a la vez.\n"
    nivelActual: 0
    nivelMaximo: 3
    costoPorNivel: 100
    icono: {fileID: 21300000, guid: 65a432f2223ca764089c2316bb1ea976, type: 3}
    botonUI: {fileID: 1361025591}
  - nombre: Publicidad
    descripcion: "\u2B50 Nivel 1 \u2013 Volantes locales\n\n+10% clientes adicionales.\n\n\u2B50
      Nivel 2 \u2013 Redes sociales\n\nClientes llegan m\xE1s r\xE1pido.\n\n\u2B50
      Nivel 3 \u2013 Anuncio en radio\n\nAumenta flujo de clientes significativamente."
    nivelActual: 0
    nivelMaximo: 3
    costoPorNivel: 100
    icono: {fileID: 21300000, guid: 06559abdb77b84045ae4b2fe4174f789, type: 3}
    botonUI: {fileID: 581718955}
  - nombre: Freidora
    descripcion: "\u2B50 Nivel 1 \u2013 Aceite m\xE1s limpio\n\nReduce probabilidad
      de quemar papas.\n\n\u2B50 Nivel 2 \u2013 Resistencia calentadora nueva\n\n+15%
      velocidad de fritura.\n\n\u2B50 Nivel 3 \u2013 Canasta doble\n\nPermite fre\xEDr
      dos porciones simult\xE1neas.\n"
    nivelActual: 0
    nivelMaximo: 3
    costoPorNivel: 100
    icono: {fileID: 21300000, guid: 61ed5d6d82bb7b644b7d20715dc45dde, type: 3}
    botonUI: {fileID: 1249500991}
  - nombre: Refrigerador
    descripcion: '

'
    nivelActual: 0
    nivelMaximo: 3
    costoPorNivel: 100
    icono: {fileID: 21300000, guid: f3b3c5c00b8742e4f9ba7dc26021dec9, type: 3}
    botonUI: {fileID: 1534046048}
